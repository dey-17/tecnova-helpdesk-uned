@model Tecnova.HelpDesk.Security.Actor
@{ Layout=null; }
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Panel · Tecnova</title><link rel="stylesheet" href="@Url.Content("~/Content/site.css")"/><link rel="stylesheet" href="@Url.Content("~/Content/portal.css")"/></head>
<body data-root="@Url.Content("~/")" data-admin="@Model.Admin.ToString().ToLowerInvariant()"><div class="app-shell"><aside class="sidebar"><a class="brand" href="@Url.Action("Panel")"><span class="brand-mark">T.</span><span>TECNOVA<small>HELP DESK</small></span></a><span class="nav-label">ESPACIO DE TRABAJO</span><nav aria-label="Menú principal"><button class="nav-link" data-section="tickets" aria-current="page">Solicitudes</button>@if(Model.Admin){<button class="nav-link" data-section="empleados">Empleados</button>}<button class="nav-link" id="salir">Cerrar sesión</button></nav><div class="sidebar-bottom"><strong>@Model.Nombre</strong><p>@Model.Rol</p></div></aside><div class="workspace"><header class="topbar"><div><span class="eyebrow">PORTAL DE EMPLEADOS</span><p>Help Desk · Soporte interno</p></div><span>@Model.Nombre · @Model.Rol</span></header><main id="portal">@Html.AntiForgeryToken()<div id="mensaje" role="status" aria-live="polite" tabindex="-1" hidden></div><section id="seccion-tickets"><h1>Solicitudes</h1><p>La gestión de tickets estará disponible en el siguiente cambio.</p></section>
@if(Model.Admin){<section id="seccion-empleados" hidden><h1>Empleados</h1><p>Administra las cuentas de acceso. Las bajas conservan sus tickets.</p><form id="empleado-form" class="form-card"><input type="hidden" name="id"/><input type="hidden" name="version"/><label>Nombre<input name="nombre" required minlength="2" maxlength="100"/></label><label>Correo<input type="email" name="email" required maxlength="254"/></label><label>Contraseña<input type="password" name="password" minlength="12" maxlength="128" autocomplete="new-password"/><small>Obligatoria al crear. Déjala vacía al editar para conservarla.</small></label><div class="actions"><button type="submit" class="button-primary">Guardar empleado</button><button type="button" id="cancelar-empleado" class="button-secondary">Limpiar formulario</button></div></form><div id="empleados-lista" class="list" aria-live="polite"></div></section>}
</main></div></div><dialog id="confirmacion"><h2 id="confirmacion-titulo">Confirmar acción</h2><p id="confirmacion-texto"></p><div class="actions"><button type="button" id="confirmar-no" class="button-secondary">Cancelar</button><button type="button" id="confirmar-si" class="button-primary">Confirmar</button></div></dialog><script src="@Url.Content("~/Scripts/portal.js")" defer></script></body></html>
